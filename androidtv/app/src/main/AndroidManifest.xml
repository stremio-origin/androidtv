<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- the phone finds the TV app by a broadcast on the local network (cast) -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- the in-app update hands the new package to the system's installer (the user confirms it) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- optional, granted by the user: lets the app open again after an update on Android 10 and up (UpdatedReceiver) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- the TV's home screen (HomeRows): the app's row and Play Next on Android 8 and up; recommendations, posted again
         after a restart, on Android 5 to 7 -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- a TV app: the remote, no touchscreen; it also opens on other Android devices with a screen -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />

    <!-- the TV's own remote service (Google TV boxes): its presence tells a phone it can open the app that way -->
    <queries>
        <package android:name="com.google.android.tv.remote.service" />
    </queries>

    <application
        android:appCategory="video"
        android:isGame="false"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:theme="@style/Theme.OriginTV">

        <activity
            android:name="app.stremioorigin.tv.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:alwaysRetainTaskState="true"
            android:preferMinimalPostProcessing="true"
            android:configChanges="layoutDirection|locale|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|keyboard|keyboardHidden|navigation|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- stremio:///detail/<type>/<id> links open the title's page -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stremioorigin" />
                <data android:scheme="stremio" />
            </intent-filter>
        </activity>
        <!-- a card on the TV's home screen (HomeRows): hands its link to the app and brings the app up as its icon does,
             so the app's task never keeps a card's link to play again on a later open (CardActivity) -->
        <activity
            android:name="app.stremioorigin.tv.CardActivity"
            android:exported="true"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- the last start died in its first seconds: its log on the screen (StartReport) -->
        <activity
            android:name="app.stremioorigin.tv.StartReport"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- Fire TV: the app can be opened from a phone over DIAL (res/xml/whisperplay.xml) -->
        <meta-data android:name="whisperplay" android:resource="@xml/whisperplay" />
        <!-- the downloaded update, read by the system's installer (ApkProvider) -->
        <provider android:name="app.stremioorigin.tv.ApkProvider" android:authorities="app.stremioorigin.tv.apk" android:exported="false" android:grantUriPermissions="true" />
        <!-- the app opens again after an update it started itself (UpdatedReceiver) -->
        <!-- the TV's home-screen rows: made at install, kept over a restart, a title the user takes off kept off (HomeRowsReceiver) -->
        <receiver android:name="app.stremioorigin.tv.HomeRowsReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.media.tv.action.INITIALIZE_PROGRAMS" />
                <action android:name="android.media.tv.action.WATCH_NEXT_PROGRAM_BROWSABLE_DISABLED" />
                <action android:name="android.media.tv.action.PREVIEW_PROGRAM_BROWSABLE_DISABLED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver android:name="app.stremioorigin.tv.UpdatedReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.MY_PACKAGE_REPLACED" /></intent-filter>
        </receiver>
    </application>
</manifest>
